# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string_here

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Server Port
PORT=5000

# External API Configuration
EXTERNAL_API_URL=https://darksalmon-crow-640021.hostingersite.com/api_get_readings.php
POLL_INTERVAL=30000

# Performance Optimization for Render
# Set to false on free tier for better performance
# Set to true if you need background services (external sync, alerts)
ENABLE_BACKGROUND_SERVICES=false

# Node Environment
NODE_ENV=production
