# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string_here

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Server Port
PORT=5000

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=https://bsl-admin.vercel.app

# External API Configuration
EXTERNAL_API_URL=https://darksalmon-crow-640021.hostingersite.com/api_get_readings.php
POLL_INTERVAL=30000
AUTO_REGISTER_EXTERNAL_MACS=true
ENABLE_ON_DEMAND_EXTERNAL_SYNC=true
ON_DEMAND_SYNC_MAX_STALENESS_MS=60000
ON_DEMAND_SYNC_MIN_INTERVAL_MS=30000

# Performance Optimization for Render
# Set to false on free tier for better performance
# Set to true if you need background services (external sync, alerts)
ENABLE_BACKGROUND_SERVICES=false

# Node Environment
NODE_ENV=production

# WhatsApp alert bridge (Node -> Python -> WhatsApp Cloud API)
WHATSAPP_ALERTS_ENABLED=false
PYTHON_BIN=python3
WHATSAPP_ALERT_TEMPLATE=factory_alert
WHATSAPP_TOKEN=YOUR_WHATSAPP_PERMANENT_TOKEN
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_TO_NUMBER=919876543210
WHATSAPP_API_VERSION=v17.0
WHATSAPP_TEMPLATE_LANG=en_US
